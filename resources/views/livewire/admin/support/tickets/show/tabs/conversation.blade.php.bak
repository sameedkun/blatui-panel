{{--
    Conversation tab — the ticket thread on the left with a reply box, a
    management sidebar (status/priority/category/agent) on the right.

    Expects: $record, $categoryOptions, $agentOptions, $statusOptions, $priorityOptions
--}}
<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

    {{-- Thread column --}}
    <div class="space-y-4 lg:col-span-2">
        <x-ui.card>
            <x-ui.card-content class="space-y-5 pt-6">
                @forelse ($record->messages as $message)
                    @if ($message->isSystem())
                        <div class="flex justify-center" wire:key="ticket-message-{{ $message->id }}">
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-muted px-3 py-1 text-xs text-muted-foreground">
                                <x-lucide-zap class="size-3" />
                                {{ $message->message }}
                                <x-ui.local-time :value="$message->created_at" show-diff="true" />
                            </span>
                        </div>
                    @else
                        @php $isStaff = $message->author_type === \App\Enum\TicketMessageAuthorType::Staff; @endphp
                        <div class="flex gap-3 {{ $isStaff ? 'flex-row-reverse' : '' }}" wire:key="ticket-message-{{ $message->id }}">
                            <x-ui.avatar class="size-8 shrink-0 rounded-full border border-border">
                                @if ($message->user?->avatarUrl())
                                    <x-ui.avatar-image :src="$message->user->avatarUrl()" :alt="$message->user->name" />
                                @endif
                                <x-ui.avatar-fallback class="text-xs font-semibold">
                                    {{ strtoupper(substr($message->user->name ?? '?', 0, 2)) }}
                                </x-ui.avatar-fallback>
                            </x-ui.avatar>

                            <div class="flex max-w-[80%] flex-col gap-1 {{ $isStaff ? 'items-end' : 'items-start' }}">
                                <div class="flex items-center gap-2 text-xs text-muted-foreground {{ $isStaff ? 'flex-row-reverse' : '' }}">
                                    <span class="font-medium text-foreground">{{ $message->user?->name ?? 'Unknown' }}</span>
                                    <x-ui.badge variant="outline" class="px-1.5 py-0 text-[10px]">{{ $isStaff ? 'Staff' : 'Requester' }}</x-ui.badge>
                                    <x-ui.local-time :value="$message->created_at" show-diff="true" />
                                </div>
                                <div class="rounded-xl border border-border/70 px-4 py-2.5 text-sm leading-relaxed whitespace-pre-line {{ $isStaff ? 'bg-primary/10' : 'bg-muted/40' }}">
                                    {{ $message->message }}
                                </div>
                            </div>
                        </div>
                    @endif
                @empty
                    <p class="py-8 text-center text-sm text-muted-foreground">No messages yet.</p>
                @endforelse
            </x-ui.card-content>
        </x-ui.card>

        {{-- Reply box --}}
        @can('tickets.manage')
            <x-ui.card>
                <x-ui.card-content class="pt-6">
                    @if ($record->status === \App\Enum\TicketStatus::Closed)
                        <div class="flex items-center gap-2 rounded-lg border border-border bg-muted/30 p-3 text-sm text-muted-foreground">
                            <x-lucide-lock class="size-4" />
                            This ticket is closed. Reopen it to reply.
                        </div>
                    @else
                        <form wire:submit="reply" class="space-y-3">
                            <x-ui.field>
                                <x-ui.field-label for="replyMessage">Reply</x-ui.field-label>
                                <x-ui.textarea id="replyMessage" wire:model="replyMessage" rows="3" placeholder="Type your reply to the requester..." />
                                @error('replyMessage')
                                    <x-ui.field-error>{{ $message }}</x-ui.field-error>
                                @enderror
                            </x-ui.field>
                            <div class="flex justify-end">
                                <x-ui.button type="submit" size="sm" wire:loading.attr="disabled" wire:target="reply" class="gap-1.5">
                                    <x-lucide-send class="size-3.5" />
                                    Send Reply
                                </x-ui.button>
                            </div>
                        </form>
                    @endif
                </x-ui.card-content>
            </x-ui.card>
        @endcan
    </div>

    {{-- Sidebar column --}}
    <div class="space-y-6 lg:col-span-1">

        {{-- Requester card --}}
        <x-ui.card>
            <x-ui.card-header class="border-b border-border/50 pb-4">
                <x-ui.card-title class="text-base">Requester</x-ui.card-title>
            </x-ui.card-header>
            <x-ui.card-content class="space-y-3 pt-6">
                @if ($record->user)
                    <div class="flex items-center gap-3 rounded-lg border border-border/60 bg-muted/20 p-3">
                        <x-ui.avatar class="size-11 shrink-0 rounded-full border border-border">
                            @if ($record->user->avatarUrl())
                                <x-ui.avatar-image :src="$record->user->avatarUrl()" :alt="$record->user->name" />
                            @endif
                            <x-ui.avatar-fallback class="text-xs font-bold">
                                {{ strtoupper(substr($record->user->name, 0, 2)) }}
                            </x-ui.avatar-fallback>
                        </x-ui.avatar>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">{{ $record->user->name }}</p>
                            <p class="truncate text-xs text-muted-foreground">{{ $record->user->email }}</p>
                        </div>
                    </div>
                    @can('users.manage')
                        <x-ui.button variant="outline" size="sm" class="w-full gap-1.5 text-xs shadow-2xs" href="{{ route('admin.users.show', $record->user) }}">
                            <x-lucide-external-link class="size-3.5" />
                            <span>View User Profile</span>
                        </x-ui.button>
                    @endcan
                @else
                    <p class="text-xs text-muted-foreground italic">Account no longer exists.</p>
                @endif
            </x-ui.card-content>
        </x-ui.card>

        {{-- Management card --}}
        <x-ui.card>
            <x-ui.card-header class="border-b border-border/50 pb-4">
                <x-ui.card-title class="text-base">Manage Ticket</x-ui.card-title>
            </x-ui.card-header>
            <x-ui.card-content class="space-y-4 pt-6">
                @can('tickets.manage')
                    <x-ui.field>
                        <x-ui.field-label for="ticketStatus">Status</x-ui.field-label>
                        <x-ui.select native id="ticketStatus" size="sm" :value="$record->status->value" :options="$statusOptions"
                            wire:change="updateStatus($event.target.value)" />
                    </x-ui.field>

                    <x-ui.field>
                        <x-ui.field-label for="ticketPriority">Priority</x-ui.field-label>
                        <x-ui.select native id="ticketPriority" size="sm" :value="$record->priority->value" :options="$priorityOptions"
                            wire:change="updatePriority($event.target.value)" />
                    </x-ui.field>

                    <x-ui.field>
                        <x-ui.field-label for="ticketCategory">Category</x-ui.field-label>
                        <x-ui.select native id="ticketCategory" size="sm" :value="(string) $record->category_id" :options="$categoryOptions"
                            placeholder="No category" wire:change="updateCategory($event.target.value)" />
                        <x-ui.field-description>Changing this may re-run auto-assignment.</x-ui.field-description>
                    </x-ui.field>

                    <x-ui.field>
                        <x-ui.field-label for="ticketAgent">Assigned Agent</x-ui.field-label>
                        <x-ui.select native id="ticketAgent" size="sm" :value="(string) $record->assigned_to" :options="$agentOptions"
                            placeholder="Unassigned" wire:change="reassignAgent($event.target.value)" />
                    </x-ui.field>
                @else
                    <dl class="space-y-3 text-sm">
                        <div>
                            <dt class="text-xs text-muted-foreground">Category</dt>
                            <dd class="font-medium">{{ $record->category?->name ?? 'None' }}</dd>
                        </div>
                        <div>
                            <dt class="text-xs text-muted-foreground">Assigned Agent</dt>
                            <dd class="font-medium">{{ $record->agent?->name ?? 'Unassigned' }}</dd>
                        </div>
                    </dl>
                @endcan
            </x-ui.card-content>
        </x-ui.card>

    </div>

</div>
